+HBH1, NXGL = b'HBH1', b'NXGL'
+def nxgl_shaders(d, label):
+    """Level-5's shader binaries (Yo-kai Watch 4: '.vsb' / '.fsb' / '.gsb' / '.esb' / '.csb' files, loose in /data/nx/shader and in shader.cpk, 1,893 of them): an HBH1 file with the program's
+    reflection tables and one NXGL record {magic 'NXGL', u32 version 1, u32 code offset, u32 code length, u32 control offset, u32 control length} (offsets from the record) holding one stage's code area
+    and control section. Graphics code areas carry the 0x12345678 header; compute ones (SDK 7) none, so the stage is glslc_stage's"""
+    out = []
+    for m in re.finditer(NXGL, d):
+        i = m.start()
+        if i & 3 or i + 0x18 > len(d): continue
+        v, co, cn, to, tn = struct.unpack_from('<5I', d, i + 4)
+        if v != 1 or i + co + cn > len(d) or i + to + tn > len(d): continue
+        code, ctl = d[i + co:i + co + cn], d[i + to:i + to + tn]
+        st = glslc_stage(ctl, code) if ctl[:4] == CTL_MAGIC else None
+        why = check(label, st, ctl, code) if st else 'no stage'
+        if why: print(f'[RED] {label} NXGL @{i:#x}: {why}; left out', flush=True); continue
+        out.append((f'{label}#NXGL@{i:#x}', st, ctl, code))
+    return out
+
