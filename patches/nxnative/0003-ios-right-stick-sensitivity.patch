 - (CGPoint)stickCentre:(int)i { return i ? _rCentre : self.stickHome; }
-- (CGFloat)stickR:(int)i { return (i ? K_RSTICK_R : K_STICK_R) * self.u; }
-- (BOOL)inRightArea:(CGPoint)p { CGRect b = _layout.controls; return p.x >= CGRectGetMaxX(b) - b.size.width * K_RSWIPE; }
+// Right stick (camera) tuning, from env.txt: DM_RSTICK_R = drag radius in layout units (full tilt at K_FULL of it; smaller = more sensitive), DM_RSTICK_AREA = the fraction of the
+// screen width from the right edge where a touch takes the right stick. Defaults here are more sensitive and wider than upstream's 60 and 1/3 (Yo-kai Watch 4 turned too slowly, and touches
+// near the middle missed the stick)
+static double rstick_env(const char *k, double d) { const char *e = getenv(k); double v = e ? atof(e) : 0; return v > 0 ? v : d; }
+- (CGFloat)stickR:(int)i { return (i ? rstick_env("DM_RSTICK_R", K_RSTICK_R / 2.0) : K_STICK_R) * self.u; }
+- (BOOL)inRightArea:(CGPoint)p { CGRect b = _layout.controls; return p.x >= CGRectGetMaxX(b) - b.size.width * MIN(rstick_env("DM_RSTICK_AREA", K_RSWIPE * 1.5), 1.0); }
